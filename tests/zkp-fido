#!/usr/bin/env bash
# Test ZKP with FIDO2 integration end-to-end against the reference server.
# Requires: hardware FIDO2 key, terces zkp init has been run OR will run here.
set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
TERCES="$SCRIPT_DIR/terces"
SERVER="$SCRIPT_DIR/tests/zkp-server"
PORT=${PORT:-8765}
HOST=127.0.0.1
BASE="http://$HOST:$PORT"

PYBIN=python3
[ -x "$SCRIPT_DIR/.venv/bin/python" ] && PYBIN="$SCRIPT_DIR/.venv/bin/python"

echo "================================================="
echo "  ZKP FIDO2 INTEGRATION TEST"
echo "================================================="
echo "  Requires hardware key. PIN + touch prompts incoming."
echo ""

echo "[1/6] init keypair (touch your key)..."
"$TERCES" zkp init

echo "[2/6] info..."
"$TERCES" zkp info

echo "[3/6] export pubkey + boot server..."
PUBKEY_JSON=$("$TERCES" zkp export)
PUBKEY_JSON="$PUBKEY_JSON" "$PYBIN" "$SERVER" --host "$HOST" --port "$PORT" >/tmp/zkp-server.log 2>&1 &
SRV_PID=$!
trap 'kill $SRV_PID 2>/dev/null || true' EXIT
for _ in $(seq 1 20); do
    curl -s -f -o /dev/null "$BASE/challenge" 2>/dev/null && break
    sleep 0.1
done

echo "[4/6] fetch nonce, prove (touch your key)..."
NONCE=$(curl -s "$BASE/challenge" | python3 -c 'import sys,json; print(json.load(sys.stdin)["nonce"])')
PROOF=$("$TERCES" zkp prove "$NONCE" 300)

echo "[5/6] POST proof to server..."
BODY=$(python3 -c "import json,sys; print(json.dumps({'proof': json.loads(sys.argv[1]), 'nonce': sys.argv[2]}))" "$PROOF" "$NONCE")
RESP=$(curl -s -w '\n%{http_code}' -X POST "$BASE/verify" -H 'Content-Type: application/json' -d "$BODY")
CODE=$(echo "$RESP" | tail -1)
echo "Response: $RESP"
[ "$CODE" = "200" ] || { echo "FAIL"; exit 1; }

echo "[6/6] replay attempt..."
RESP=$(curl -s -w '\n%{http_code}' -X POST "$BASE/verify" -H 'Content-Type: application/json' -d "$BODY")
CODE=$(echo "$RESP" | tail -1)
echo "Response: $RESP"
[ "$CODE" = "401" ] || { echo "FAIL: replay should have been rejected"; exit 1; }

echo ""
echo "================================================="
echo "  PASS - FIDO2 proof verified, replay rejected"
echo "================================================="
